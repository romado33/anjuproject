# Copy to .env and set values. Never commit .env.

# Required for LLM + embeddings (OpenAI)
OPENAI_API_KEY=sk-your-key-here

# Optional overrides
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Set true to force offline heuristics (no OpenAI calls), useful for CI or local UI without a key
OFFLINE_MODE=false

# Classification confidence threshold (0-1); below triggers human review flag
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.65

# Chroma persistence path (relative to project root)
CHROMA_PERSIST_DIRECTORY=data/chroma_db

# SQLite case store
CASE_STORE_PATH=data/cases.sqlite3

# Adapter endpoints / parameters (Integrations page); gitignored by default
# INTEGRATION_SETTINGS_PATH=data/integration_settings.json

# Simulated integration latency (seconds) for mock adapters
MOCK_INTEGRATION_LATENCY_SECONDS=0.15

# Luminee sidebar promo (optional overrides)
# LUMINEE_BOOKING_URL=https://www.anjusoftware.com/eclinical/luminee/
# LUMINEE_PROTOCOL_SUMMARIZER_URL=https://luminee-prod1tm1.anjuclinical.com/login
